{
  "$defs": {
    "AlertWebhookConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable real-time webhook alerting on DLQ quarantine or batch failures",
          "title": "Enabled",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Webhook URL (Slack, MS Teams, PagerDuty, or custom endpoint). Supports ${SLACK_WEBHOOK_URL}",
          "title": "Url"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional Slack / Teams channel name",
          "title": "Channel"
        },
        "min_quarantined_threshold": {
          "default": 1,
          "description": "Minimum number of quarantined rows in a batch before triggering an alert",
          "title": "Min Quarantined Threshold",
          "type": "integer"
        },
        "include_summary": {
          "default": true,
          "description": "Include root-cause breakdown in the alert message",
          "title": "Include Summary",
          "type": "boolean"
        }
      },
      "title": "AlertWebhookConfig",
      "type": "object"
    },
    "ExpectationConfig": {
      "properties": {
        "name": {
          "description": "Data quality check name",
          "title": "Name",
          "type": "string"
        },
        "expr": {
          "description": "Boolean SQL validation expression that must evaluate to TRUE",
          "title": "Expr",
          "type": "string"
        },
        "action": {
          "default": "quarantine",
          "description": "Action on failure: 'quarantine' (route to DLQ), 'warn' (log), 'fail_batch' (halt)",
          "title": "Action",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explanation of why this rule exists",
          "title": "Description"
        }
      },
      "required": [
        "name",
        "expr"
      ],
      "title": "ExpectationConfig",
      "type": "object"
    },
    "FieldDefinition": {
      "properties": {
        "name": {
          "description": "Target column name",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "Spark SQL data type",
          "title": "Type",
          "type": "string"
        },
        "expr": {
          "description": "SQL transformation expression",
          "title": "Expr",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Semantic description for Unity Catalog / Genie Text-to-SQL",
          "title": "Description"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alternative alias for column description",
          "title": "Comment"
        },
        "is_primary_key": {
          "default": false,
          "description": "Whether this column is part of the primary key",
          "title": "Is Primary Key",
          "type": "boolean"
        },
        "mask_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unity Catalog Column Mask UDF name",
          "title": "Mask Policy"
        }
      },
      "required": [
        "name",
        "type",
        "expr"
      ],
      "title": "FieldDefinition",
      "type": "object"
    },
    "ForeignKeyReference": {
      "properties": {
        "column": {
          "description": "Foreign key column name in this table",
          "title": "Column",
          "type": "string"
        },
        "referenced_table": {
          "description": "Target dimension table (catalog.schema.table)",
          "title": "Referenced Table",
          "type": "string"
        },
        "referenced_column": {
          "description": "Target primary key column in dimension table",
          "title": "Referenced Column",
          "type": "string"
        },
        "relationship_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explains relationship for Genie text-to-SQL",
          "title": "Relationship Description"
        }
      },
      "required": [
        "column",
        "referenced_table",
        "referenced_column"
      ],
      "title": "ForeignKeyReference",
      "type": "object"
    },
    "MetricDefinition": {
      "properties": {
        "name": {
          "description": "Business metric name (e.g., Total MRR)",
          "title": "Name",
          "type": "string"
        },
        "sql_formula": {
          "description": "SQL aggregation expression (e.g., SUM(mrr_amount))",
          "title": "Sql Formula",
          "type": "string"
        },
        "description": {
          "description": "Business definition and guidance for Genie queries",
          "title": "Description",
          "type": "string"
        },
        "synonyms": {
          "description": "Common alternative names used in natural language",
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "name",
        "sql_formula",
        "description"
      ],
      "title": "MetricDefinition",
      "type": "object"
    },
    "PiiSplitConfig": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "target_catalog": {
          "title": "Target Catalog",
          "type": "string"
        },
        "target_schema": {
          "title": "Target Schema",
          "type": "string"
        },
        "target_table": {
          "title": "Target Table",
          "type": "string"
        },
        "table_comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Semantic description of the PII table for catalog & compliance",
          "title": "Table Comment"
        },
        "unique_keys": {
          "items": {
            "type": "string"
          },
          "title": "Unique Keys",
          "type": "array"
        },
        "foreign_key_expr": {
          "title": "Foreign Key Expr",
          "type": "string"
        },
        "foreign_key_name": {
          "title": "Foreign Key Name",
          "type": "string"
        },
        "cluster_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cluster By",
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "name",
        "target_catalog",
        "target_schema",
        "target_table",
        "unique_keys",
        "foreign_key_expr",
        "foreign_key_name",
        "fields"
      ],
      "title": "PiiSplitConfig",
      "type": "object"
    },
    "RuntimeConfig": {
      "properties": {
        "trigger_type": {
          "default": "AvailableNow",
          "title": "Trigger Type",
          "type": "string"
        },
        "max_mbytes_per_trigger": {
          "default": 2000,
          "title": "Max Mbytes Per Trigger",
          "type": "integer"
        },
        "checkpoint_location": {
          "title": "Checkpoint Location",
          "type": "string"
        },
        "audit_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Centralized operational telemetry audit table FQDN",
          "title": "Audit Table"
        },
        "alert_webhook": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertWebhookConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional real-time alert webhook configuration"
        }
      },
      "required": [
        "checkpoint_location"
      ],
      "title": "RuntimeConfig",
      "type": "object"
    },
    "SourceConfig": {
      "properties": {
        "catalog": {
          "title": "Catalog",
          "type": "string"
        },
        "schema": {
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "stream_filter_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Filter Field"
        },
        "stream_filter_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Filter Value"
        },
        "payload_column": {
          "default": "payload",
          "description": "Name of the semi-structured payload column in source",
          "title": "Payload Column",
          "type": "string"
        },
        "payload_type": {
          "default": "variant",
          "description": "Encoding: 'variant' (Databricks native binary VARIANT), 'json_string', or 'struct'",
          "title": "Payload Type",
          "type": "string"
        }
      },
      "required": [
        "catalog",
        "schema",
        "table"
      ],
      "title": "SourceConfig",
      "type": "object"
    },
    "TargetTableConfig": {
      "properties": {
        "catalog": {
          "title": "Catalog",
          "type": "string"
        },
        "schema": {
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "title": "Table",
          "type": "string"
        },
        "table_comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Semantic description of the table for catalog & Genie",
          "title": "Table Comment"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alternative alias for table_comment",
          "title": "Comment"
        },
        "table_type": {
          "default": "dimension",
          "description": "'fact' or 'dimension' for Kimball modeling",
          "title": "Table Type",
          "type": "string"
        },
        "unique_keys": {
          "items": {
            "type": "string"
          },
          "title": "Unique Keys",
          "type": "array"
        },
        "cluster_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cluster By",
          "type": "array"
        },
        "prune_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prune Column"
        },
        "schema_evolution": {
          "default": "mergeSchema",
          "title": "Schema Evolution",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "title": "Fields",
          "type": "array"
        },
        "foreign_keys": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ForeignKeyReference"
          },
          "title": "Foreign Keys",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricDefinition"
          },
          "title": "Metrics",
          "type": "array"
        },
        "enable_dlq": {
          "default": true,
          "description": "Enable automated Dead-Letter Queue quarantine for malformed records",
          "title": "Enable Dlq",
          "type": "boolean"
        },
        "dlq_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom DLQ table FQDN. Defaults to <target_table>_dlq",
          "title": "Dlq Table"
        },
        "track_rescued_data": {
          "default": true,
          "description": "Preserves raw unmapped payload in _rescued_payload",
          "title": "Track Rescued Data",
          "type": "boolean"
        },
        "store_rescued_as_variant": {
          "default": true,
          "description": "Stores _rescued_payload as Databricks native VARIANT",
          "title": "Store Rescued As Variant",
          "type": "boolean"
        },
        "expectations": {
          "description": "Declarative data quality rules",
          "items": {
            "$ref": "#/$defs/ExpectationConfig"
          },
          "title": "Expectations",
          "type": "array"
        }
      },
      "required": [
        "catalog",
        "schema",
        "table",
        "unique_keys",
        "fields"
      ],
      "title": "TargetTableConfig",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "entity_name": {
      "title": "Entity Name",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "business_domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Domain classification (e.g. Finance, Subscriptions, Sales)",
      "title": "Business Domain"
    },
    "source": {
      "$ref": "#/$defs/SourceConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "gold": {
      "$ref": "#/$defs/TargetTableConfig"
    },
    "pii_splits": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PiiSplitConfig"
      },
      "title": "Pii Splits",
      "type": "array"
    }
  },
  "required": [
    "entity_name",
    "source",
    "runtime",
    "gold"
  ],
  "title": "EntityPipelineConfig",
  "type": "object"
}
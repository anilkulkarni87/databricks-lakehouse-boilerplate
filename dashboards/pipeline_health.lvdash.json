{
  "datasets": [
    {
      "name": "dataset_audit_kpis",
      "displayName": "Ingestion KPI Summary",
      "queryLines": [
        "SELECT ",
        "  count(*) AS total_micro_batches, ",
        "  coalesce(sum(source_rows_read), 0) AS total_rows_ingested, ",
        "  coalesce(sum(target_rows_inserted), 0) AS total_rows_inserted, ",
        "  coalesce(sum(target_rows_updated), 0) AS total_rows_updated, ",
        "  coalesce(sum(dlq_rows_quarantined), 0) AS total_rows_quarantined, ",
        "  round(coalesce(sum(dlq_rows_quarantined) * 100.0 / nullif(sum(source_rows_read), 0), 0.0), 2) AS overall_quarantine_rate_pct, ",
        "  round(avg(execution_duration_ms) / 1000.0, 2) AS avg_batch_duration_sec, ",
        "  sum(CASE WHEN status = \"FAILED\" THEN 1 ELSE 0 END) AS failed_batches ",
        "FROM default.pipeline_batch_audit ",
        "WHERE batch_timestamp >= current_timestamp() - INTERVAL 24 HOURS"
      ]
    },
    {
      "name": "dataset_dlq_summary",
      "displayName": "DLQ Quarantine Root Causes",
      "queryLines": [
        "SELECT ",
        "  coalesce(_dlq_reason, \"UNKNOWN_VIOLATION\") AS failure_category, ",
        "  count(*) AS quarantined_record_count, ",
        "  round(count(*) * 100.0 / sum(count(*)) over(), 1) AS share_pct ",
        "FROM default.dim_subscriptions_dlq ",
        "WHERE _dlq_timestamp >= current_timestamp() - INTERVAL 24 HOURS ",
        "GROUP BY 1 ",
        "ORDER BY 2 DESC ",
        "LIMIT 10"
      ]
    },
    {
      "name": "dataset_batch_audit_trail",
      "displayName": "Recent Batch Execution Audit Trail",
      "queryLines": [
        "SELECT ",
        "  batch_id, ",
        "  entity_name, ",
        "  batch_timestamp, ",
        "  status, ",
        "  source_rows_read, ",
        "  target_rows_inserted, ",
        "  target_rows_updated, ",
        "  dlq_rows_quarantined, ",
        "  execution_duration_ms, ",
        "  error_message ",
        "FROM default.pipeline_batch_audit ",
        "ORDER BY batch_timestamp DESC ",
        "LIMIT 100"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview_canvas",
      "displayName": "Pipeline Health & Observability",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
